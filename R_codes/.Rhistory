# Lines show weather thresholds only. A tick also needs the correct stage,
# feeding history, age, and dormancy state before any transition can occur.
# Showing every year adds identical panels and becomes unreadable for long
# runs. Four years display the identical repeated pattern.
years <- head(unique(weather_daily$simulation_year), 4)
png(file.path(output_dir, "weather_thresholds_by_year.png"), width = 9000, height = 800, res = 160)
# Reserve a shared legend panel so the biological labels do not cover curves.
panel_rows <- ceiling(length(years) / 2)
panels <- matrix(seq_len(panel_rows * 2), ncol = 2, byrow = TRUE)
panels[panels > length(years)] <- 0
layout(rbind(panels, rep(length(years) + 1L, 2)),
heights = c(rep(1, panel_rows), 0.5))
par(mar = c(4.4, 4.5, 2.2, 1), oma = c(0, 0, 3.5, 0),
mgp = c(2.5, 0.7, 0))
thresholds <- c(28, 58, 81, 110)
# Match the temperature gates in halsey_tick_core.R. Other stage, feeding,
# timer and dormancy requirements must also be met before transitions occur.
threshold_labels <- c(
"28 C-days: Adult awakening; start pre-oviposition",
"58 C-days: Larvae -> nymphs; nymph awakening",
"81 C-days: Nymphs -> adults",
"110 C-days: Eggs -> larvae (hatching); larval awakening"
)
colors <- c("steelblue", "darkgreen", "purple", "firebrick")
limits <- range(c(weather_daily$cdd7_raw_Cday, thresholds), na.rm = TRUE)
for (year_value in years) {
x <- weather_daily[weather_daily$simulation_year == year_value, ]
plot(x$day_of_year, x$cdd7_raw_Cday, type = "l", ylim = limits,
xlim = c(1, 365), xlab = "Day of year", ylab = "7-day DD (C-days)",
main = paste("Simulation year", year_value))
abline(h = thresholds, col = colors, lty = 2)
}
par(mar = c(2.2, 0, 0, 0))
plot.new()
legend("center", threshold_labels, col = colors, lty = 2,
bty = "n", cex = 0.9, y.intersp = 1.15)
mtext("Below 58 C-days in autumn: dormancy for non-feeding larvae, nymphs and adults.",
side = 1, line = 0, cex = 0.8)
mtext("Repeated mean climate: Halsey thresholds (first four simulation years)",
outer = TRUE, line = 1, cex = 1.05)
dev.off()
