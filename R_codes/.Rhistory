weather_daily$dd6_raw_Cday <- weather_daily$tmean_C - 6
weather_daily$cdd7_raw_Cday <- trailing_complete(weather_daily$dd6_raw_Cday, 7, "sum")
weather_daily$tmean17_C <- trailing_complete(weather_daily$tmean_C, 17, "mean")
