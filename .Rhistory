)
# Seven zone colors, each 50% transparent
zone_colors <- grDevices::adjustcolor(
grDevices::hcl.colors(7, palette = "Set2"),
alpha.f = 0.5
)
# Overlay zones on the same world-coordinate grid
raster::plot(
NetLogoR::world2raster(zoneworld),
add = TRUE,
col = zone_colors,
breaks = seq(0.5, 7.5, by = 1),
legend = FALSE
)
# Draw locations above both raster layers
points(feederloc.sf, pch = 1, lwd = 2)
points(camloc.sf, pch = 4, lwd = 2)
